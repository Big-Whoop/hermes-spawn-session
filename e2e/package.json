{
  "name": "hermes-spawn-session-e2e",
  "private": true,
  "type": "module",
  "description": "Playwright e2e specs for the spawn-session Hermes plugin (backend + Desktop).",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "list": "playwright test --list",
    "test:backend": "playwright test --project=backend",
    "test:desktop": "playwright test --project=desktop",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
